{
  "manifest_version": 3,
  "name": "Sticky",
  "version": "1.0.0",
  "description": "Capture links, posts, and notes with one keystroke or right-click into a clean, local-only library.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Sticky — Open Library"
  },
  "background": {
    "scripts": [
      "lib/db.js",
      "lib/storage.js",
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "tabs",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-scripts/generic.js"],
      "css": ["content-scripts/toast.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.reddit.com/*"],
      "js": ["content-scripts/reddit.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "save-to-sticky": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "MacCtrl+Shift+E"
      },
      "description": "Save focused Reddit post or current page to Sticky"
    },
    "open-library": {
      "suggested_key": {
        "default": "Alt+L",
        "mac": "MacCtrl+L"
      },
      "description": "Open Sticky Library"
    }
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sticky@local.addon",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
